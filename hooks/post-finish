#!/bin/sh
set -eu

EVENT=$(cat)
UPLOAD_PATH=$(printf '%s' "$EVENT" | jq -r '.Event.Upload.Storage.Path')
INFO_PATH=$(printf '%s' "$EVENT" | jq -r '.Event.Upload.Storage.InfoPath')
UPLOAD_ID=$(printf '%s' "$EVENT" | jq -r '.Event.Upload.ID')
META_PATH=$(printf '%s' "$EVENT" | jq -r '.Event.Upload.MetaData.path // empty')

if [ -n "$META_PATH" ]; then
  DEST_DIR="/data/processing/$META_PATH"
else
  DEST_DIR="/data/processing/$UPLOAD_ID"
fi

if [ -d "$DEST_DIR" ]; then
  rm -rf "$DEST_DIR"
fi
mkdir -p "$DEST_DIR"
if zstd -dc "$UPLOAD_PATH" | tar xf - -C "$DEST_DIR"; then
  rm -f "$UPLOAD_PATH" "$INFO_PATH"
  echo "Extracted $UPLOAD_ID to $DEST_DIR" >&2
else
  echo "Failed to extract $UPLOAD_ID (not a tar.zst?)" >&2
fi
